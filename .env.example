# Plantilla de configuración local. Copiar a `.env` antes de construir:
#
#     cp .env.example .env
#     printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# El `.env` real no se versiona: el UID/GID es propio de cada máquina.

# UID/GID del usuario del host, para que los archivos que escriban los
# contenedores en ./data y ./outputs no queden como root.
#
# Se pasan como `build args` al Dockerfile, que crea adentro un usuario con ese
# mismo número. Por eso, si se cambian, hay que reconstruir las imágenes
# (`docker compose build`), no basta con reiniciar los contenedores.
#
# Casi siempre son 1000 (primer usuario de la máquina); comprobar con `id -u`
# y `id -g`. Si el archivo no existe, docker-compose.yml asume 1000.
UID=1000
GID=1000

# Limites de memoria por contenedor
CBP_DASK_MEM=2g
CBP_SPARK_MEM=3g
